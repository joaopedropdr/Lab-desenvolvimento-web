generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// Definicao do schema do banco
model Usuario{
  // os tipos dos campos sao do prisma. Eles devem comecar com letra maiuscula
  id Int @id @default(autoincrement())
  nome String 
  email String @unique
  senha  String
  perfil Perfil @default(MORADOR)
  criadoEm DateTime @default(now())
  // define o nome da tabela no banco
  @@map("usuarios")
}

model Ecoponto {
  id Int @id @default(autoincrement())
  nome String
  latitude String
  longitude String
  decricao String?
  cep String?
  logradouro String?
  numero String?
  bairro String?
  cidade String?
  uf String?
  nota Int?
  criadoEm DateTime @default(now())
  // Relacionamento com a tabela lixeiras
  lixeiras[]
  @@map("ecopontos")
}

model Ecoponto {
  id Int @id @default(autoincrement())
  uuid_sensor String
  tipo Tipo 
  volume_max Int
  nivel_cheio Int
  ecoponto_id Int 
  criadoEm DateTime @default(now())
  // Relacionamento com a tabela ecoponto
  // onDelete:Cascade faz as lixeiras relacionadas com o ecoponto serem deletadas quando o ecoponto for deletado
  ecoponto Ecoponto @relation(fields:[ecoponto_id], references:[id], onDelete:Cascade)
  @@map("lixeiras")
}
